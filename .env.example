# VYRO — copy to .env.local. Never commit real secrets.
# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never import these into client components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push and Vercel Cron (keep all private values server-only).
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional app URL (used later for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
